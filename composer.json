{
    "name": "webisters/database",
    "description": "Webisters Database Library",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "database",
        "mariadb",
        "mysql",
        "mysqli",
        "data-definition",
        "data-manipulation"
    ],
    "authors": [
        {
            "name": "Hafiz Muhammad Moaz",
            "email": "hafizmoazkhalid@gmail.com",
            "homepage": "https://github.com/HafizMMoaz"
        }
    ],
    "homepage": "https://webisters.com/packages/database",
    "support": {
        "email": "support@webisters.com",
        "issues": "https://github.com/webisters/database/issues",
        "forum": "https://github.com/webisters/forum",
        "source": "https://github.com/webisters/database",
        "docs": "https://webisters.com"
    },
    "funding": [
        {
            "type": "Webisters Sponsor",
            "url": "https://webisters.com/sponsor"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mysqli": "*",
        "webisters/debug": "*",
        "webisters/log": "*"
    },
    "require-dev": {
        "webisters/coding-standard": "*",
        "jetbrains/phpstorm-attributes": "^1.0",
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Framework\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Database\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}


